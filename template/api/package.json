{
  "name": "my-api",
  "version": "1.0.0",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun --watch .",
    "build": "bun type-check && bun build --compile --target bun --outfile server .",
    "build:docker": "docker build -t my-api .",
    "type-check": "tsc --incremental false",
    "format": "prettier --write \"./src/**/*.{js,cjs,mjs,jsx,ts,tsx}\"",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun ./src/scripts/seed.ts"
  },
  "dependencies": {
    "@elysiajs/openapi": "1.4.16",
    "@t3-oss/env-core": "0.13.11",
    "drizzle-orm": "0.45.3",
    "elysia": "1.4.30",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "drizzle-kit": "0.31.11",
    "postgres": "3.4.9",
    "prettier": "3.9.9",
    "prettier-plugin-organize-imports": "4.3.0",
    "typescript": "7.0.2"
  }
}
