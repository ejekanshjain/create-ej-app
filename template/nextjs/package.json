{
  "name": "my-project",
  "description": "A Legendary Project",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "email:dev": "email dev --dir src/emails",
    "email:test": "bun --conditions=react-server ./src/scripts/test-mail.ts",
    "workflow:inspect": "workflow inspect runs --web",
    "build": "bun --bun next build",
    "build:docker": "docker build -t my-app .",
    "analyze": "ANALYZE=true bun --bun next build --webpack",
    "start": "bun --bun next start",
    "lint": "eslint",
    "type-check": "tsgo --incremental false",
    "format": "prettier --log-level warn --write \"./src/**/*.{js,cjs,mjs,jsx,ts,tsx}\" --write \"./tests/**/*.{js,cjs,mjs,jsx,ts,tsx}\"",
    "test": "bun test",
    "test:real": "TEST_DATABASE=postgres bun test",
    "db:push": "drizzle-kit push",
    "db:seed": "bun --conditions=react-server ./src/scripts/seed.ts",
    "db:reset": "bun --conditions=react-server ./src/scripts/reset-db.ts",
    "db:studio": "drizzle-kit studio",
    "gen:auth": "bunx auth@latest generate"
  },
  "dependencies": {
    "@ejekanshjain/simple-email-validator": "1.0.4",
    "@hookform/resolvers": "5.9.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@paralleldrive/cuid2": "3.3.0",
    "@react-email/render": "2.1.0",
    "@t3-oss/env-nextjs": "0.13.11",
    "@tanstack/react-query": "5.103.2",
    "@tanstack/react-table": "9.2.4",
    "@vercel/otel": "2.1.3",
    "better-auth": "1.7.6",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "drizzle-orm": "0.45.3",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "next-safe-action": "8.7.3",
    "next-themes": "0.4.6",
    "nextjs-toploader": "3.9.17",
    "nodemailer": "10.0.10",
    "nuqs": "2.10.1",
    "postgres": "3.4.9",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.88.0",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "workflow": "4.8.9",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@next/bundle-analyzer": "16.3.6",
    "@react-email/preview-server": "5.2.10",
    "@tailwindcss/postcss": "4.3.3",
    "@types/bun": "1.4.2",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.6",
    "prettier": "3.9.9",
    "prettier-plugin-organize-imports": "4.3.0",
    "prettier-plugin-tailwindcss": "0.8.1",
    "react-email": "6.11.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  },
  "trustedDependencies": [
    "@nestjs/core",
    "@swc/core",
    "cbor-extract",
    "esbuild",
    "sharp",
    "unrs-resolver"
  ]
}
